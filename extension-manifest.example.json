{
  "id": "example.weather",
  "name": "天气扩展",
  "description": "给对话提供天气查询能力",
  "version": "0.1.0",
  "author": "your-name",
  "tags": ["utility", "weather"],
  "capabilities": ["tool.weather", "message.reply"],
  "permissions": ["network.http"],
  "requires": [],
  "config_schema": [
    {
      "key": "city",
      "label": "默认城市",
      "type": "string",
      "description": "天气查询的默认城市"
    }
  ],
  "tools": [
    {
      "name": "weather",
      "description": "查询天气",
      "parameters": {
        "type": "object",
        "properties": {"city": {"type": "string"}},
        "required": ["city"]
      }
    }
  ],
  "ui": {
    "route": "external:example.weather",
    "icon": "cloud",
    "group": "extensions",
    "order": 100
  },
  "entrypoint": "plugin.exe",
  "runtime": { "type": "process", "bus_abi": 1 }
}
