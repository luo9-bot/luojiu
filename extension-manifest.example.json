{
  "id": "example.weather",
  "name": "天气扩展",
  "description": "给对话提供天气查询能力",
  "version": "0.1.0",
  "author": "your-name",
  "tags": ["utility", "weather"],
  "capabilities": ["tool.weather", "message.reply"],
  "permissions": ["network.http"],
  "requires": [],
  "config_schema": [
    {
      "key": "city",
      "label": "默认城市",
      "type": "string",
      "description": "天气查询的默认城市"
    }
  ],
  "ui": {
    "route": "external:example.weather",
    "icon": "cloud",
    "group": "extensions",
    "order": 100
  },
  "entrypoint": "plugin.dll",
  "runtime": {
    "abi": 1,
    "symbols": {
      "init": "luo9_extension_init",
      "shutdown": "luo9_extension_shutdown",
      "on_event": "luo9_extension_on_event"
    }
  }
}
